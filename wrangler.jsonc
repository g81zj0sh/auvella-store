{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auvella-store",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  }
}
