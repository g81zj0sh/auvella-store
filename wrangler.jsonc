{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auvella-store",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    { "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }
  ],
  // v208: "people viewed this in the last 24 hours" counts (lib/productViewsApi).
  "d1_databases": [
    {
      "binding": "VIEWS_DB",
      "database_name": "auvella-product-views",
      "database_id": "6d67a92d-11e4-4a69-8a54-338670220d29"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  // v196: Workers Logs, so a "1102 exceeded resource limits" shows whether
  // CPU or memory was the limit hit.
  "observability": {
    "enabled": true
  }
}
